# Used by Server Components / sitemap for server-to-server API calls
API_BASE_URL=https://samiuls-portfolio-server.vercel.app

# Used by the browser for dashboard mutations and the resume download
NEXT_PUBLIC_BASE_URL=https://samiuls-portfolio-server.vercel.app

# Shared secret for POST /api/revalidate, which the API calls after every
# project write. Must match REVALIDATE_SECRET in the API. Without it the route
# answers 503 and project data stays cached indefinitely.
REVALIDATE_SECRET=
